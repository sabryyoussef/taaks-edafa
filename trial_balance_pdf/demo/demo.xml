<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo accounts -->
        <record id="trial_balance_pdf_demo_account" model="account.account">
            <field name="name">Demo Trial Balance Account</field>
            <field name="code">TB-DEMO</field>
            <field name="account_type">asset_current</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        <record id="trial_balance_pdf_demo_counterpart" model="account.account">
            <field name="name">Demo Trial Balance Counterpart</field>
            <field name="code">TB-CP</field>
            <field name="account_type">income_other</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Demo journal -->
        <record id="trial_balance_pdf_demo_journal" model="account.journal">
            <field name="name">Demo General Journal (TB)</field>
            <field name="code">TBD</field>
            <field name="type">general</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="default_account_id" ref="trial_balance_pdf.trial_balance_pdf_demo_counterpart"/>
        </record>

        <!-- Demo entries for initial and current balances -->
        <record id="trial_balance_pdf_demo_move_before" model="account.move">
            <field name="move_type">entry</field>
            <field name="date">2026-01-01</field>
            <field name="journal_id" ref="trial_balance_pdf.trial_balance_pdf_demo_journal"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="line_ids" eval="[(0, 0, {
                'name': 'Initial debit',
                'account_id': ref('trial_balance_pdf.trial_balance_pdf_demo_account'),
                'debit': 200.0,
                'credit': 0.0
            }), (0, 0, {
                'name': 'Initial debit - counterpart',
                'account_id': ref('trial_balance_pdf.trial_balance_pdf_demo_counterpart'),
                'debit': 0.0,
                'credit': 200.0
            })]"/>
        </record>

        <record id="trial_balance_pdf_demo_move_in_period" model="account.move">
            <field name="move_type">entry</field>
            <field name="date">2026-01-15</field>
            <field name="journal_id" ref="trial_balance_pdf.trial_balance_pdf_demo_journal"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="line_ids" eval="[(0, 0, {
                'name': 'Period credit',
                'account_id': ref('trial_balance_pdf.trial_balance_pdf_demo_account'),
                'debit': 0.0,
                'credit': 40.0
            }), (0, 0, {
                'name': 'Period credit - counterpart',
                'account_id': ref('trial_balance_pdf.trial_balance_pdf_demo_counterpart'),
                'debit': 40.0,
                'credit': 0.0
            })]"/>
        </record>

        <!-- Demo wizard record (TransientModel; for UI demo only) -->
        <record id="trial_balance_pdf_demo_wizard" model="trial.balance.report">
            <field name="company_id" ref="base.main_company"/>
            <field name="start_date">2026-01-01</field>
            <field name="end_date">2026-01-31</field>
            <field name="state">draft</field>
            <field name="journals_ids" eval="[(6, 0, [ref('trial_balance_pdf.trial_balance_pdf_demo_journal')])]"/>
        </record>
    </data>
</odoo>
