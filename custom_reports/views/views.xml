<odoo>
    <data>
        <record id="account_custom_report_wizard" model="ir.ui.view">
            <field name="name">account.custom.reports.wizard</field>
            <field name="model">custom.reports</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="account_id"/>
                            <field name="account_partner_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Print" class="btn btn-primary" type="object" name="action_print" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_account_custom_report_wizard" model="ir.actions.act_window">
            <field name="name">Loan &amp; Custody Reports</field>
            <field name="res_model">custom.reports</field>
            <field name="view_id" ref="account_custom_report_wizard"/>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_action_account_custom_report_wizard" name="Loan &amp; Custody Reports" action="action_account_custom_report_wizard" parent="account.menu_finance_reports"/>
    </data>
</odoo>