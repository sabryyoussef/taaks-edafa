<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Define Model View -->
    <record id="trial_balance_general_acount_group_view_form" model="ir.ui.view">
        <field name="name">trial.balance.general.group.view.form</field>
        <field name="model">trial.balance.general.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                    <field name="account_group_ids" widget="many2many_tags"/>
                        <!-- <field name="journals_ids" options="{'no_create': True}"
                               widget="many2many_tags"/> -->
                        <field name="company_id" invisible="1"/>
                        <field name="state" widget="radio"/>
                    </group>
                </sheet>
                <footer>
                    <button name="button_to_get_pdf" string="PDF" type="object"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
<!--    Model Action-->
    <record id="general_trial_balance_group_action" model="ir.actions.act_window">
        <field name="name">Trial Balance General group</field>
        <field name="res_model">trial.balance.general.group</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="trial_balance_general_acount_group_view_form"/>
        <field name="target">new</field>
    </record>
<!--    Top Menu-->
    <menuitem id="account_audit_reports" name="Audit Reports" sequence="8"
              parent="account.menu_finance_reports">
        <menuitem id="account_general_trial_balance_group_report"
                  name="General Trial Balance with group account"
                  action="general_trial_balance_group_action"/>
    </menuitem>
</odoo>