<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Define Model View -->
    <record id="view_account_list_inherit" model="ir.ui.view">
        <field name="name">account.account.list.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <!-- Locate the tree view and add the group_id field directly -->
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="group_id" />
            </xpath>
        </field>
    </record>
</odoo>